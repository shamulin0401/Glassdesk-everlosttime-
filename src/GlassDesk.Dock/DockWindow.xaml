<controls:GlassWindow
    x:Class="GlassDesk.Dock.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI"
    Title="GlassDesk Dock"
    AutomationProperties.Name="GlassDesk 程序坞"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Topmost="True"
    AllowDrop="True"
    Drop="OnExternalDrop"
    DragOver="OnExternalDragOver"
    MouseRightButtonUp="OnDockBackgroundRightClick">

  <controls:GlassWindow.Resources>
    <Style x:Key="DockEntryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <!--
    图标行是真实的应用磁贴（D-07/D-08）。磁贴条（放大、滚动、命中）由
    DockTileStrip 承担；这里的宿主只负责把它嵌进玻璃面板。
  -->
  <Border
      Background="Transparent"
      BorderThickness="0"
      SnapsToDevicePixels="True">

    <Grid ClipToBounds="True">
      <!-- Glass remains in screen coordinates; the live shared silhouette slides over it. -->
      <controls:LiquidGlassSurface x:Name="GlassSurface" />
      <Grid x:Name="DockVisualRoot" ClipToBounds="True" RenderTransformOrigin="0,0">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="DockSlideTransform" />
        </Grid.RenderTransform>
        <StackPanel x:Name="DockContentLayer" Orientation="Vertical" Margin="10,8">

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="LauncherButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                Style="{StaticResource DockEntryButton}"
                Background="Transparent" BorderThickness="0"
                ToolTip="启动台" AutomationProperties.Name="打开启动台"
                MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                MouseRightButtonUp="OnLauncherButtonRightClick"
                Click="OnLauncherButtonClick">
          <controls:PhoneBorder x:Name="LaunchpadTile" Width="48" Height="48" CornerRadius="16"
                     Background="Transparent" BorderThickness="0">
            <controls:LaunchpadGlyph OutlineBrush="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
          </controls:PhoneBorder>
        </Button>
        <Button x:Name="ThisPcButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                Style="{StaticResource DockEntryButton}"
                Background="Transparent" BorderThickness="0"
                ToolTip="此电脑" AutomationProperties.Name="打开此电脑"
                MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                Click="OnThisPcButtonClick">
          <Viewbox x:Name="ThisPcTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
              <Path Data="M6,6 H42 Q45,6 45,9 V29 Q45,32 42,32 H6 Q3,32 3,29 V9 Q3,6 6,6 Z M24,32 V39 M15,40 H33"
                    Fill="Transparent"
                    Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    StrokeThickness="3.5" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
        </Button>
        <Button x:Name="DesktopIconsButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                Style="{StaticResource DockEntryButton}"
                ToolTip="切换桌面图标显示" AutomationProperties.Name="切换桌面图标显示"
                MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                Click="OnDesktopIconsButtonClick">
          <Viewbox x:Name="DesktopIconsTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
              <Path Data="M6,6 H42 Q45,6 45,9 V29 Q45,32 42,32 H6 Q3,32 3,29 V9 Q3,6 6,6 Z M24,32 V39 M15,40 H33"
                    Fill="Transparent"
                    Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    StrokeThickness="3.5" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Path Data="M11,12 H15 V16 H11 Z M11,22 H15 V26 H11 Z M23,15 H37 M32,10 L37,15 L32,20 M37,24 H23 M28,19 L23,24 L28,29"
                    Fill="Transparent"
                    Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    StrokeThickness="3.5" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
        </Button>
        <ContentControl x:Name="TileStripHost"
                        AutomationProperties.Name="固定的应用"
                        Focusable="False" />

        <!--
          运行中的应用与固定区分开：中间一条竖线让用户一眼看出
          左边是自己摆的、右边是此刻开着的。
        -->
        <Border x:Name="RunningGroupSeparator"
                Width="1"
                Margin="8,10,8,10"
                Visibility="Collapsed"
                Background="#26FFFFFF" />

        <ContentControl x:Name="RunningTileStripHost"
                        AutomationProperties.Name="正在运行的应用"
                        Focusable="False" />

        <!--
          右侧系统组：托盘展开按钮与时间日期共用一个圆角底板。
          底板只在两个子项至少有一个可见时出现，两个子项各自独立显隐。
        -->
        <Border x:Name="SystemGroupHost"
                VerticalAlignment="Center"
                CornerRadius="14"
                Visibility="Collapsed"
                Background="#1FFFFFFF"
                SnapsToDevicePixels="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="TrayPanelButton"
                    Padding="0"
                    Style="{StaticResource DockEntryButton}"
                    ToolTip="系统托盘"
                    AutomationProperties.Name="打开系统托盘"
                    Visibility="Collapsed"
                    Click="OnTrayPanelButtonClick">
              <Path Width="20" Height="20" Stretch="Uniform"
                    Data="M4,15 L12,7 L20,15"
                    Fill="Transparent"
                    Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    StrokeThickness="2.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Button>
            <StackPanel x:Name="ClockHost" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock x:Name="ClockTimeText"
                         HorizontalAlignment="Right"
                         FontWeight="SemiBold"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock x:Name="ClockDateText"
                         Margin="0,1,0,0"
                         HorizontalAlignment="Right"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock
          x:Name="StatusText"
          Margin="2,8,2,0"
          HorizontalAlignment="Center"
          FontSize="11"
          Visibility="Collapsed"
          Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />

        </StackPanel>
      </Grid>
    </Grid>
  </Border>

</controls:GlassWindow>
