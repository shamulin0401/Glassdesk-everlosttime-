<controls:GlassWindow
    x:Class="GlassDesk.Dock.TrayPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI"
    Title="GlassDesk 系统托盘"
    AutomationProperties.Name="GlassDesk 系统托盘"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Width="272"
    WindowStartupLocation="Manual"
    Topmost="True">

  <controls:GlassWindow.Resources>

    <Style x:Key="TrayHeaderButton" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="13">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#1FFFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#0FFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TrayCellButton" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#24FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#12000000" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 输出设备列表里的一行：整行可点，当前默认那行加底色。 -->
    <Style x:Key="MixerDeviceRow" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,5,6,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#1FFFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#0FFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      音量滑轨：默认的 WPF 模板是浅色主题的立体滑轨，放进玻璃面板里很突兀，
      所以自带一套细轨加圆钮的模板。PART_Track 是 Slider 的必需部件。
    -->
    <Style x:Key="TrayVolumeSlider" TargetType="Slider">
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="#33FFFFFF" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Height="4">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="#CC1684FF" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Height="4">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="14" Height="14" Fill="#FFFFFF" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </controls:GlassWindow.Resources>

  <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
    <Grid ClipToBounds="True">
      <controls:LiquidGlassSurface x:Name="GlassSurface" />

      <Grid x:Name="PanelContent" Margin="16,14,16,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 表头：标题在左，重新读取在右。 -->
        <Grid Grid.Row="0">
          <TextBlock
              FontSize="14"
              FontWeight="SemiBold"
              VerticalAlignment="Center"
              Text="应用托盘"
              Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
          <Button
              x:Name="RefreshButton"
              HorizontalAlignment="Right"
              Style="{StaticResource TrayHeaderButton}"
              ToolTip="重新读取托盘图标"
              AutomationProperties.Name="重新读取托盘图标"
              Click="OnRefreshClick">
            <Path
                Width="15" Height="15" Stretch="Uniform"
                Fill="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 7.58,4 4.01,7.58 4,12 4,16.42 7.58,20 12,20 15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 8.69,18 6,15.31 6,12 6,8.69 8.69,6 12,6 13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 Z" />
          </Button>
        </Grid>

        <!-- 图标网格。行数随托盘图标数量变化，超过上限时自己滚动。 -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
          <ScrollViewer
              x:Name="IconScroll"
              MaxHeight="236"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
            <UniformGrid x:Name="TrayIconGrid" Columns="5" />
          </ScrollViewer>
          <TextBlock
              x:Name="EmptyHint"
              Margin="2,8,2,8"
              FontSize="12"
              TextWrapping="Wrap"
              Visibility="Collapsed"
              Text="通知区域此刻没有图标。"
              Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>

        <Border Grid.Row="2" Height="1" Margin="0,12,0,12" Background="#26FFFFFF" />

        <!-- 系统控制 -->
        <StackPanel Grid.Row="3">
        <StackPanel x:Name="SystemControlsPanel">
          <TextBlock
              FontSize="12"
              Text="系统控制"
              Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path
                Grid.Column="0"
                Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"
                Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                StrokeThickness="1.7" Fill="Transparent"
                Data="M3,5 H21 V17 H3 Z M9,20 H15 M12,17 V20" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="13"
                Text="隐藏系统任务栏"
                Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <CheckBox
                x:Name="TaskbarToggle"
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{DynamicResource LiquidPillSwitch}"
                ToolTip="写入 Windows 自己的“自动隐藏任务栏”设置"
                AutomationProperties.Name="隐藏系统任务栏"
                Checked="OnTaskbarToggleChanged"
                Unchecked="OnTaskbarToggleChanged" />
          </Grid>

          <TextBlock
              x:Name="InputLanguageText"
              Margin="23,8,0,0"
              FontSize="12"
              Visibility="Collapsed"
              Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />

          <Grid x:Name="VolumeRow" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path
                Grid.Column="0"
                Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"
                Fill="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                Data="M3,9 V15 H7 L12,20 V4 L7,9 Z M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V16.02 C15.48,15.29 16.5,13.77 16.5,12 Z M14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 19,15.17 16.89,17.85 14,18.71 V20.77 C18.01,19.86 21,16.28 21,12 21,7.72 18.01,4.14 14,3.23 Z" />
            <Slider
                x:Name="VolumeSlider"
                Grid.Column="1"
                Minimum="0"
                Maximum="1"
                SmallChange="0.02"
                LargeChange="0.1"
                VerticalAlignment="Center"
                Style="{StaticResource TrayVolumeSlider}"
                AutomationProperties.Name="系统音量"
                ValueChanged="OnVolumeValueChanged" />
            <TextBlock
                x:Name="VolumeText"
                Grid.Column="2"
                Margin="10,0,0,0"
                MinWidth="34"
                FontSize="12"
                VerticalAlignment="Center"
                TextAlignment="Right"
                Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />

            <!-- 与 Windows 音量弹出页一样：右侧这个按钮打开「设备 + 音量合成器」那一页。 -->
            <Button
                x:Name="MixerOpenButton"
                Grid.Column="3"
                Width="22"
                Height="22"
                Margin="8,0,0,0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                FocusVisualStyle="{x:Null}"
                ToolTip="输出设备与音量合成器"
                AutomationProperties.Name="打开输出设备与音量合成器"
                Click="OnMixerOpenClick">
              <Path
                  Width="14" Height="14" Stretch="Uniform"
                  Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                  StrokeThickness="1.8" Fill="Transparent"
                  Data="M4,7 H20 M17,4 L20,7 L17,10 M4,15 H20 M7,12 L4,15 L7,18" />
            </Button>
          </Grid>

          <!--
            输入/输出设备选择。设备列表在面板打开、以及下拉展开时才重新枚举：
            枚举要读注册表里的属性表，放进每秒的轮询里没有必要，
            而且在下拉展开时重建列表会跟正在选的人打架。
          -->
          <Grid x:Name="OutputDeviceRow" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                Text="输出"
                Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <ComboBox
                x:Name="OutputDeviceCombo"
                Grid.Column="1"
                Margin="8,0,0,0"
                AutomationProperties.Name="音频输出设备"
                DropDownOpened="OnDeviceDropDownOpened"
                SelectionChanged="OnOutputDeviceChanged" />
          </Grid>

          <Grid x:Name="InputDeviceRow" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                Text="输入"
                Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <ComboBox
                x:Name="InputDeviceCombo"
                Grid.Column="1"
                Margin="8,0,0,0"
                AutomationProperties.Name="音频输入设备"
                DropDownOpened="OnDeviceDropDownOpened"
                SelectionChanged="OnInputDeviceChanged" />
          </Grid>
        </StackPanel>

        <!--
          音量页：点音量条右侧的展开按钮进入，上下两栏——上「输出设备」、下「音量合成器」，
          与 Windows 自己的音量弹出页同一套分栏。行都在代码里生成：设备与会话都是动态的，
          用模板反而要为每一种行写一遍数据绑定。
        -->
        <StackPanel x:Name="MixerPanel" Visibility="Collapsed">
          <Grid Margin="0,0,0,2">
            <TextBlock
                FontSize="12"
                VerticalAlignment="Center"
                Text="音量"
                Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button
                x:Name="MixerBackButton"
                HorizontalAlignment="Right"
                Padding="8,2"
                FontSize="12"
                Content="返回"
                AutomationProperties.Name="返回系统控制"
                Click="OnMixerBackClick" />
          </Grid>

          <TextBlock
              Margin="0,10,0,6"
              FontSize="13"
              FontWeight="SemiBold"
              Text="输出设备"
              Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
          <StackPanel x:Name="MixerDeviceList" />

          <TextBlock
              Margin="0,12,0,6"
              FontSize="13"
              FontWeight="SemiBold"
              Text="音量合成器"
              Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
          <StackPanel x:Name="MixerSessionList" />

          <TextBlock
              x:Name="MixerHint"
              Margin="0,8,0,0"
              FontSize="11"
              TextWrapping="Wrap"
              Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>

</controls:GlassWindow>
